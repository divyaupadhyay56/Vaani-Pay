# --- LLM (used for NLU) ---
# Get an API key at https://console.x.ai
GROK_API_KEY=your_grok_api_key
GROK_MODEL=grok-4.6
GROK_BASE_URL=https://api.x.ai/v1

# --- WebSocket per-connection conversation state (not auth sessions) ---
REDIS_URL=redis://localhost:6379/0
USE_REDIS=false   # false = in-memory sessions, good enough for local dev

# --- Database ---
# SQLite file path. Leave unset to default to <project_root>/vaani_pay.db
DB_PATH=

# --- Auth ---
# How long a login session token stays valid, in hours.
SESSION_TTL_HOURS=24

# --- CORS ---
# Comma-separated list of allowed origins for the REST API.
# Leave empty to default to http://localhost:8000 and http://127.0.0.1:8000 only.
CORS_ALLOWED_ORIGINS=

# --- Tabby (BNPL) ---
# Standalone client only (app/tabby_client.py) — not wired into any route
# or flow yet. Get sandbox keys from https://tabby.ai (merchant dashboard).
# Never commit real keys; TABBY_SECRET_KEY must never reach the frontend.
TABBY_BASE_URL=https://api.tabby.ai
TABBY_PUBLIC_KEY=
TABBY_SECRET_KEY=
TABBY_MERCHANT_CODE=
